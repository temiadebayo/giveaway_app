# =============================================================================
# Giveaway App — environment
# Copy to .env.local and fill in. .env* is gitignored.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required by every API route and server action (guest join, FPS tracking, admin
# panel). Bypasses RLS completely — server-side only, never expose to the client
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Resend) ----------------------------------------------------------
# KYC decisions and withdrawal notifications. Omit to disable outbound email.
RESEND_API_KEY=re_xxx

# --- Sentry ------------------------------------------------------------------
# Build-time source map upload. Not needed for local development.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# =============================================================================
# Not currently integrated — listed so nobody wires them up by accident:
#
#   Stripe          The previous template listed STRIPE_SECRET_KEY and friends.
#                   There is no Stripe code in this app. Deposits are manual bank
#                   transfers approved by an admin. A real PSP (Paystack or
#                   Flutterwave, for NGN) is Phase 2.
#   reCAPTCHA       Listed previously but never used. Rate limiting and captcha on
#                   guest join is Phase 1.
# =============================================================================
